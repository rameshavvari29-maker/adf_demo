{
	"name": "productsink",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"productfile": {
				"type": "string",
				"defaultValue": "@concat('product_',formatDateTime(utcNow(),'yyyyMMdd_HHmmss'),'.csv')"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().productfile",
					"type": "Expression"
				},
				"folderPath": "products",
				"fileSystem": "e-commerce"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	},
	"type": "Microsoft.DataFactory/factories/datasets"
}